<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/fox_background">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/clipboard_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clipboard"
            android:textColor="?attr/foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_clipboard_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btn_clear_all"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_clear_all"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Clear All" />

        <ImageView
            android:id="@+id/btn_close_clipboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Close Clipboard" />

    </LinearLayout>

    <!-- Privacy Notice Banner -->
    <TextView
        android:id="@+id/privacy_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Clips are stored locally on device and automatically deleted after 1 hour."
        android:textColor="?attr/foreground_2"
        android:textSize="11sp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp" />

    <!-- RecyclerView for Clipboard items -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/clipboard_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tv_empty_clipboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Copied text will show up here"
            android:textColor="?attr/foreground_2"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
