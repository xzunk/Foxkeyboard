<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="unicodesinhala" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- General background and text -->
        <item name="fox_background">@color/m3_bg_light</item>
        <item name="accent">@color/m3_accent</item>
        <item name="foreground">@color/text_on_light</item>
        <item name="foreground_2">@color/text_on_light_variant</item>
        <item name="isLight">true</item>

        <!-- Key surfaces and borders -->
        <item name="border">@color/m3_bg_light</item>
        <item name="keyNormal">@color/m3_key_light</item>
        <item name="keyFunction">@color/m3_func_light</item>
        <item name="keyAction">@color/m3_accent</item>

        <!-- Pressed states -->
        <item name="keyNormalPressed">@color/m3_func_pressed_light</item>
        <item name="keyFunctionPressed">@color/m3_func_pressed_light</item>
        <item name="keyActionPressed">@color/m3_accent_pressed</item>
        <item name="keyShadowColor">#20000000</item>

        <!-- Special keys -->
        <item name="keySpecial">@color/m3_key_light</item>
        <item name="keySpecialPressed">@color/m3_func_pressed_light</item>
    </style>

    <style name="Theme.fox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fox_background">@color/m3_bg_light</item>
        <item name="colorPrimary">@color/m3_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/m3_bg_light</item>
        <item name="colorOnSurface">@color/text_on_light</item>
        <item name="colorOnSurfaceVariant">@color/text_on_light_variant</item>
        <item name="preferenceTheme">@style/ThemeOverlay.fox.Preference</item>
    </style>

    <style name="ThemeOverlay.fox.Preference" parent="PreferenceThemeOverlay">
        <item name="android:textColorPrimary">@color/text_on_light</item>
        <item name="android:textColorSecondary">@color/text_on_light_variant</item>
        <item name="colorControlActivated">@color/m3_accent</item>
    </style>

    <!-- Light fallback -->
    <style name="Light" parent="unicodesinhala">
        <item name="isLight">true</item>
    </style>

    <style name="LightNoBorder" parent="Light">
        <item name="border">@android:color/transparent</item>
        <item name="keyShadowColor">@android:color/transparent</item>
    </style>

    <!-- Night fallback -->
    <style name="Night" parent="unicodesinhala">
        <item name="isLight">false</item>
        <item name="fox_background">@color/m3_bg_dark</item>
        <item name="foreground">@color/text_on_dark</item>
        <item name="foreground_2">@color/text_on_dark_variant</item>
        <item name="border">@color/m3_bg_dark</item>

        <item name="keyNormal">@color/m3_key_dark</item>
        <item name="keyFunction">@color/m3_func_dark</item>
        <item name="keyAction">@color/m3_accent</item>

        <item name="keyNormalPressed">@color/m3_func_pressed_dark</item>
        <item name="keyFunctionPressed">@color/m3_func_pressed_dark</item>
        <item name="keyActionPressed">@color/m3_accent_pressed</item>
        <item name="keyShadowColor">#20000000</item>
    </style>

    <style name="NightNoBorder" parent="Night">
        <item name="border">@android:color/transparent</item>
        <item name="keyShadowColor">@android:color/transparent</item>
    </style>
</resources>
