<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="3dp" android:right="3dp" android:top="4dp" android:bottom="4dp">
                <shape>
                    <solid android:color="?attr/keyActionPressed" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="3dp" android:right="3dp" android:top="4dp" android:bottom="4dp">
                <shape>
                    <solid android:color="?attr/keyAction" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
